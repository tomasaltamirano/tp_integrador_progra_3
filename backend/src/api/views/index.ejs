<%- include("partials/head.ejs") %>
<%- include("partials/nav.ejs") %>

<div class="cart-container admin-container">
    <div class="cart-header">
        <h2><%= about %></h2>
    </div>

    <div class="cart-layout">
        <div id="contenedor-productos" class="admin-grid">
            <% productosArray.forEach(producto => { %>
                <div class="cart-item">
                    <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                    <div class="item-details">
                        <h4><%= producto.nombre %></h4>
                        <p>ID: <%= producto.id %></p>
                        <p>US$ <%= producto.precio %></p>
                        <p><%= producto.categoria %></p>
                        <% if (producto.activo) { %>
                            <span style="color: #4ade80;">Activo</span>
                        <% } else { %>
                            <span style="color: #ff6b6b;">Inactivo</span>
                        <% } %>
                    </div>
                    <div class="item-price-col">
                        <% if (producto.activo) { %>
                            <button 
                                class="btn-comenzar" 
                                style="background-color: #8b0000; font-size: 0.8rem; padding: 1rem 1rem; width: 90px;"
                                onclick="cambiarEstado(<%= producto.id %>, 'desactivar')">
                                Desactivar
                            </button>
                        <% } else { %>
                            <button 
                                class="btn-comenzar" 
                                style="background-color: #166534; font-size: 0.8rem; padding: 1rem 1rem; width: 90px;"
                                onclick="cambiarEstado(<%= producto.id %>, 'activar')">
                                Activar
                            </button>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<script src="/js/admin/index.js"></script>


<%- include("partials/footer.ejs") %>